{
  "name": "pvzhtbot-mod",
  "version": "0.3.1",
  "private": true,
  "description": "Greenhouse - unofficial plugin-based client mod for pvzhtbot.com",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "serve": "node dev-server.js",
    "dev": "concurrently -n build,serve -c green,cyan \"npm:watch\" \"npm:serve\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0"
  }
}
